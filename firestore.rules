rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public / Course Catalog (Read-only for all users) ---
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if false;
    }

    match /quiz_questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    match /_metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Shared Quiz Bank (Read-only for students; write restricted) ---
    match /quiz_bank/{questionId} {
      allow read: if true;
      allow write: if request.auth != null; // For seeding/admin
    }

    // --- Isolated User Progress (Course completion) ---
    match /student_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Isolated Quiz Zone History (Per-student isolation) ---
    match /student_quiz_history/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /attempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
